---
import Base from '../../layouts/Base.astro';
import { yearWordCounts } from '../../utils/year-word-counts';
import media from '../../generated/media.json';
const years = [{"year": "2026", "title": "Tools for teams, and what comes next", "description": "Building service and client tools, sharing the process, and preparing for third-party logistics.", "photo": "flow-stage"}, {"year": "2025", "title": "Handing the system over", "description": "I handed off provisioning and moved into full-time AI automation engineering.", "photo": "export-img-0788"}, {"year": "2024", "title": "Building out the automation", "description": "I built out automation while coordinating provisioning, logistics, and field readiness.", "photo": "setup-2024"}, {"year": "2023", "title": "Making the process work", "description": "I implemented processes, stewarded the department toward consistent delivery, and received centrexIT’s Quality First Award.", "photo": "build-2023"}, {"year": "2022", "title": "Turning provisioning around", "description": "I cleared the inherited backlog and began rebuilding provisioning.", "photo": "product-img-4389"}, {"year": "2021", "title": "Joining centrexIT", "description": "I finally secured the centrexIT job in December, after applying in spring and fall.", "photo": "build-2021"}, {"year": "2020", "title": "Hawaii with Safemark", "description": "Work at Sea Life Park in February, continuing the field-service years.", "photo": "hawaii-mountains"}, {"year": "2019", "title": "Working across the country", "description": "My first experience of cross-country corporate travel.", "photo": "utah-equipment"}, {"year": "2018", "title": "My first job", "description": "The beginning of my working life: a first job and a notary license.", "photo": null}, {"year": "2017", "title": "Graduation, and the iPhone X", "description": "Leaving high school and finding a phone I finally wanted to keep.", "photo": "product-img-0137"}, {"year": "2016", "title": "Family, theatre, and technology", "description": "An iMac with my grandmother, a school election, and The Crucible.", "photo": "election-podium"}, {"year": "2015", "title": "A more serious computer", "description": "The MacBook Pro, iPhone 6s Plus, and the designs I kept returning to.", "photo": "setup-2015"}, {"year": "2014", "title": "Design changed everything", "description": "From the Nexus 5 to HTC and iPhone, and a growing attachment to the Mac.", "photo": "setup-2014"}, {"year": "2013", "title": "High school, and the Nexus dream", "description": "My first year of high school, more freedom, and the phone I had been waiting for.", "photo": "product-img-20131101-001649-original"}, {"year": "2012", "title": "Tablets, a tumble, and a touch-screen laptop", "description": "Transformer Prime, the new iPad, and a Windows 8 laptop before the Mac.", "photo": "addition-img-8022"}, {"year": "2011", "title": "The birthday laptop, and the iPad I wanted", "description": "A Toshiba Satellite for my birthday. But I wanted an iPad 2!", "photo": "toshiba-2011-open"}];
---
<Base title="Through the years" description="Work milestones and personal photographs, year by year.">
<article class="article"><h1>Through the years</h1>
<p>Work, family, travel, and the technology I’ve lived with.</p>
<div class="year-list">{years.map(entry => <section class:list={["year-entry", {"year-entry-text": !entry.photo && entry.year !== "2018"}]}>
{(entry.photo || entry.year === "2018") && <a class="year-photo" href={`/years/${entry.year}/`} aria-label={`Explore ${entry.year}`}>
{entry.photo ? <img src={media[entry.photo as keyof typeof media].thumb} alt={media[entry.photo as keyof typeof media].alt} width="400" height="300" loading="lazy" /> : <img src="/images/stories/seaworld-equipment.jpg" alt="Equipment from the Safemark years, 2018–2020." loading="lazy" width="400" height="300" />}
</a>}<div><h2><a href={`/years/${entry.year}/`}>{entry.year} — {entry.title}</a></h2><span class="meta">{yearWordCounts[entry.year].toLocaleString('en-US')} words</span><p>{entry.description}</p><small>{entry.photo ? media[entry.photo as keyof typeof media].caption : entry.year === '2018' ? 'From the Safemark years, 2018–2020.' : ''}</small></div>
</section>)}</div>
<p><a href="/away/">Away from the desk</a> · <a href="/work/">Work history</a></p>
</article></Base>
